    "title":"driving lesson",
    "utterances":[
  {
    "speaker": "grandson",
    "text": "Can I please honk at the break?",
    "intent": "request",
    "dialogue_act": "question",
    "emotion": "excited",
    "generation_gap_indicator": "none",
    "interruption_role": "none",
    "interruption_type": "none"
  },
  {
    "speaker": "grandmother",
    "text": "Okay, honk at the break. Drive, Austin. I don't want to make this too long. Put it in drive. Okay. There's a car coming, moving around. Just drive slow. Okay, you're fine.",
    "intent": "advise",
    "dialogue_act": "command",
    "emotion": "neutral",
    "generation_gap_indicator": "none",
    "interruption_role": "none",
    "interruption_type": "none"
  },
  {
    "speaker": "grandson",
    "text": "Thanks.",
    "intent": "acknowledge",
    "dialogue_act": "statement-non-opinion",
    "emotion": "happy",
    "generation_gap_indicator": "none",
    "interruption_role": "none",
    "interruption_type": "none"
  },
  {
    "speaker": "grandmother",
    "text": "Okay, you can make the turn. Make the turn, Austin. You have to give a little gas.",
    "intent": "advise",
    "dialogue_act": "command",
    "emotion": "neutral",
    "generation_gap_indicator": "none",
    "interruption_role": "none",
    "interruption_type": "none"
  },
  {
    "speaker": "grandson",
    "text": "I'm giving it some gas.",
    "intent": "inform",
    "dialogue_act": "statement-non-opinion",
    "emotion": "neutral",
    "generation_gap_indicator": "none",
    "interruption_role": "none",
    "interruption_type": "none"
  },
  {
    "speaker": "grandmother",
    "text": "Not too much. That's enough. That's enough. Austin, slow down. Slow down, Austin.",
    "intent": "advise",
    "dialogue_act": "command",
    "emotion": "frustrated",
    "generation_gap_indicator": "none",
    "interruption_role": "none",
    "interruption_type": "none"
  },
  {
    "speaker": "grandson",
    "text": "Don't freak out too much. You're acting like I'm trying to win a race or something.",
    "intent": "criticize",
    "dialogue_act": "statement-opinion",
    "emotion": "frustrated",
    "generation_gap_indicator": "emotional over-sensitivity",
    "interruption_role": "none",
    "interruption_type": "none"
  },
  {
    "speaker": "grandmother",
    "text": "I am not 'freaking out.' I am trying to keep us alive. You think this is a game, and it’s very disrespectful when you roll your eyes at my instructions.",
    "intent": "criticize",
    "dialogue_act": "statement-opinion",
    "emotion": "angry",
    "generation_gap_indicator": "perceived disrespect",
    "interruption_role": "none",
    "interruption_type": "none"
  },
  {
    "speaker": "grandson",
    "text": "I wasn't rolling my eyes, I was just checking the mirrors! Relax.",
    "intent": "oppose",
    "dialogue_act": "disagreement",
    "emotion": "frustrated",
    "generation_gap_indicator": "none",
    "interruption_role": "none",
    "interruption_type": "none"
  },
  {
    "speaker": "grandmother",
    "text": "Don't tell me to relax while you're speeding! Okay, okay, Austin. Okay, stop. Put on the brakes now. Put on the brakes.",
    "intent": "advise",
    "dialogue_act": "command",
    "emotion": "fear",
    "generation_gap_indicator": "none",
    "interruption_role": "none",
    "interruption_type": "none"
  },
  {
    "speaker": "grandson",
    "text": "Why?",
    "intent": "confirm",
    "dialogue_act": "question",
    "emotion": "neutral",
    "generation_gap_indicator": "none",
    "interruption_role": "none",
    "interruption_type": "none"
  },
  {
    "speaker": "grandmother",
    "text": "Put on the brakes! Austin, put on the brakes.",
    "intent": "advise",
    "dialogue_act": "command",
    "emotion": "fear",
    "generation_gap_indicator": "none",
    "interruption_role": "none",
    "interruption_type": "none"
  },
  {
    "speaker": "grandson",
    "text": "I'm making another joke.",
    "intent": "inform",
    "dialogue_act": "statement-non-opinion",
    "emotion": "happy",
    "generation_gap_indicator": "none",
    "interruption_role": "none",
    "interruption_type": "none"
  },
  {
