      "emotion": "neutral",
      "generation_gap_indicator": "none",
      "interruption_role": "none",
      "interruption_type": "none"
    },
    {
      "speaker": "grandson",
      "text": "Oh, okay. I thought you wanted me to zigzag. My bad.",
