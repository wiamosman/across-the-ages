      "dialogue_act": "statement-opinion",
      "emotion": "neutral",
      "generation_gap_indicator": "none",
      "interruption_role": "none",
      "interruption_type": "none"
    },
    {
      "speaker": "grandfather",
      "text": "No zigzagging! Just steady. Go to the middle of the puddle.",
      "intent": "advise",
      "dialogue_act": "command",
