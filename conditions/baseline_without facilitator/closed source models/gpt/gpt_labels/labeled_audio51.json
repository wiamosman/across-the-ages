      "interruption_type": "none"
    },
    {
      "speaker": "grandson",
      "text": "Okay.",
      "intent": "acknowledge",
      "dialogue_act": "acknowledge",
      "emotion": "neutral",
      "generation_gap_indicator": "none",
      "interruption_role": "none",
      "interruption_type": "none"
    },
    {
      "speaker": "grandfather",
      "text": "Don't let be disturbed because some of them may run across the road and you will see them. Don't worry, don't worry until you're not ready to drive. Concentrate on the bottom of the car. Get ready to stop or touch the bottom and very gently—",
      "intent": "advise",
